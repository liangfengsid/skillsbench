    "api-sandbox-tasks": {
      "name": "api-sandbox-tasks",
      "key_points": [
        "Access tokens expire within seconds (often between code block executions). If you login in one block and call an API in the next, you'll get `401: unauthorized`.",
        "Never invent values — always look up IDs/tokens/passwords via APIs",
        "Always paginate fully — loop until empty response, don't hardcode page counts",
        "Use standard library only — no `os.system`, no external packages like `spotipy`"
      ],
